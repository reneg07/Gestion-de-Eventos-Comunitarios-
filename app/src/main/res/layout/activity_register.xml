<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textColor="@color/green_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="60dp" />

        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_subtitle"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp" />

        <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_nombre"
                android:textColorHint="@color/green_hint"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:inputType="textPersonName"
                android:maxLines="1"
                tools:ignore="Autofill"/>
        <EditText
            android:id="@+id/etApellido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_apellido"
            android:textColorHint="@color/green_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:maxLines="1"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_telefono"
            android:textColorHint="@color/green_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="phone"
            android:maxLines="1"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_correo"
            android:textColorHint="@color/green_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/etContrasenaReg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_contrasena"
            android:textColorHint="@color/green_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:maxLines="1"
            tools:ignore="Autofill" />

        <EditText
            android:id="@+id/etConfirmarContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_confirmar_contrasena"
            android:textColorHint="@color/green_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:maxLines="1"
            tools:ignore="Autofill" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_green"
            android:text="@string/btn_crear_cuenta"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="@string/btn_regresar"
            android:textColor="@color/text_medium"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
